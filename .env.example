# Copier ce fichier en .env et remplacer toutes les valeurs factices.
# Ne jamais committer le fichier .env.

# Django
DJANGO_SECRET_KEY=changeme-use-a-long-random-string-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

# PostgreSQL
POSTGRES_DB=secondemand
POSTGRES_USER=secondemand_user
POSTGRES_PASSWORD=changeme-db-password
POSTGRES_HOST=db

# Hôtes autorisés (liste séparée par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1
